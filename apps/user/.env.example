# user 서비스 로컬 개발용 환경변수. 복사해서 .env 로 사용: cp .env.example .env
# 값은 infra/docker-compose.yml 의 postgres 설정과 일치.
DATABASE_URL="postgresql://gachamind:gachamind@localhost:5432/gachamind"

# JWT 서명 키. 실제 배포에선 반드시 강한 랜덤값으로 교체.
# game-session이 토큰을 로컬 검증하게 되면 같은 값을 공유해야 한다(신원 브릿지).
JWT_SECRET="dev-secret-change-me"
