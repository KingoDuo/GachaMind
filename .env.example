# 로컬 개발용 예시. 각 서비스가 참조하는 환경변수 모음.
# 인프라를 docker(infra:up)로 띄우고 서비스는 pnpm dev로 돌릴 때 이 값들을 쓴다.

# 공유 인프라
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://gachamind:gachamind@localhost:5432/gachamind
RABBITMQ_URL=amqp://localhost:5672

# 서비스 간 주소 (로컬 pnpm dev 기준)
MATCHMAKING_URL=http://localhost:4000
USER_URL=http://localhost:4010
# game-session 샤드 이름 목록. 로컬은 브라우저가 포트로 직접 붙어야 해서 샤드 이름 = 포트(SHARD_ID 를 안 주면 포트가 이름이 된다).
GAME_SESSION_SHARDS=4001,4002,4003,4004

# 세션 토큰(JWT) 서명 키. user(발급)와 game-session(검증)이 같은 값을 써야 한다. 없으면 둘 다 dev-secret.
JWT_SECRET=dev-secret
